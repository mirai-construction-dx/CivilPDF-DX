# =============================================================================
# CivilPDF-DX — Production environment for docker-compose.prod.yml
# -----------------------------------------------------------------------------
# Copy to .env (same directory as docker-compose.prod.yml) and fill in values:
#     cp .env.prod.example .env
# .env is gitignored — NEVER commit real secrets.
#
# 注: M365 の tenant_id / client_id / client_secret は環境変数ではなく、
#     起動後に管理 API/UI（PATCH /api/v1/m365/settings）で設定し DB に暗号化保存する。
#     ここで設定するのは Fernet 鍵（暗号化用）とアクセス元ネットワーク制限のみ。
# =============================================================================

# ── PostgreSQL（compose が DATABASE_URL を自動組み立て）───────────────────────
POSTGRES_DB=civilpdf
POSTGRES_USER=civilpdf
# 必須。生成例: openssl rand -hex 24
POSTGRES_PASSWORD=

# 外部 PostgreSQL を使う場合のみ、compose の environment をコメントアウトして上書き:
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/civilpdf

# ── 公開ポート / プロセス数 ───────────────────────────────────────────────────
# frontend nginx をホストに公開するポート（前段で TLS 終端する）
FRONTEND_PORT=8080
# uvicorn ワーカー数（目安: 2 × CPU コア数）
UVICORN_WORKERS=4

# ── セキュリティ（必須）───────────────────────────────────────────────────────
# JWT 署名鍵。必須。生成例: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── バージョン（リポジトリ VERSION と一致させる）────────────────────────────────
APP_VERSION=0.9.0

# RFC 3161 ローカルタイムスタンプ署名のフォールバック HMAC 鍵。
# 既定値 "change-me-in-production" のままだと署名が脆弱になるため本番では必須上書き。
# 生成例: openssl rand -hex 32
TIMESTAMP_HMAC_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON 配列。同梱 nginx プロキシ経由なら SPA は同一オリジンだが、
# 直接 API アクセスする場合に備えて公開オリジンを指定する。
# Web コンソールと Tauri デスクトップクライアントを許可:
#   Linux/macOS: tauri://localhost / Windows: http://tauri.localhost
CORS_ORIGINS=["https://civilpdf.mirai-dx-platform.com","tauri://localhost","http://tauri.localhost"]

# ── ファイルアップロード ──────────────────────────────────────────────────────
# UPLOAD_DIR は compose 側で /app/uploads に固定（named volume にマウント）。
MAX_FILE_SIZE_MB=100

# ── AI（任意 / Claude 文書分類・セマンティック検索・要約・構造抽出）─────────────
ANTHROPIC_API_KEY=

# ── RFC 3161 外部 TSA（任意 / 未設定ならローカル HMAC タイムスタンプにフォールバック）──
# TSA_URL=https://freetsa.org/tsr
# TSA_POLICY_OID=1.3.6.1.4.1.13762.3
# TSA_TIMEOUT_SECONDS=10

# ── Microsoft 365（任意）──────────────────────────────────────────────────────
# client_secret の DB 暗号化に使う Fernet 鍵。
# 生成例: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
M365_FERNET_KEY=
# M365 ログイン許可ネットワーク（空欄=全許可。本番は LAN セグメントを指定）
# 例: M365_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
M365_ALLOWED_NETWORKS=

# ── PDF/A 検証（任意 / veraPDF, Java 17+ 必要。Docker イメージ未同梱）──────────
# VERAPDF_PATH=/usr/local/bin/verapdf

# ── アプリ配信（PDF Editor Client の配布窓口 /api/v1/apps）──────────────────────
# インストーラー配布元の CDN / GitHub Releases ベース URL。
# 未設定なら配信ページは「近日公開予定」表示（ダウンロード URL を返さない）。
# 例: APPS_RELEASE_BASE_URL=https://github.com/mirai-construction-dx/CivilPDF-DX/releases/download/editor-v1.12.6
APPS_RELEASE_BASE_URL=
# ビルドパイプラインが注入するビルドメタデータ（/api/v1/apps/build-info で表示）。
# APPS_BUILD_NUMBER=1.12.6+build.42
# APPS_BUILD_COMMIT=
# APPS_BUILD_DATE=2026-04-28
# 強制最低バージョン（未満はブロック対象として UI 表示）。
# APPS_MIN_SUPPORTED_VERSION=1.12.6
# 配布物の SHA-256 チェックサム（パッケージ ID 別。ハイフンは _ に置換し大文字化）。
# 例: APPS_SHA256_WIN_EXE=<sha256>  /  APPS_SHA256_WIN_MSI=<sha256>（配布は Windows のみ）
