# =============================================================================
# ⛔ RETIRED（2026-09-18）: 本番アプリは docker compose スタックで稼働する。
#   /etc/systemd/system/civilpdf-dx.service（compose up -d）
#     + /etc/systemd/system/civilpdf-dx-cloudflared.service（tunnel）
# このホスト直 uvicorn 構成は、Neon DATABASE_URL（2026-08-29 失効）を参照した
# 旧世代の名残であり、compose 移行後に退役した。新規インストールしないこと。
# 退役手順: docs/operations/runbook.md §2.1
# =============================================================================

[Unit]
Description=CivilPDF-DX Console Backend (uvicorn 127.0.0.1:8180) [RETIRED — use docker compose]
Documentation=https://github.com/mirai-construction-dx/CivilPDF-DX

[Service]
Type=simple
WorkingDirectory=%h/Projects/Mirai-DX-Project/CivilPDF-DX/src/console/backend

# %h/.local/bin に Alembic / uvicorn がインストールされていることを前提にする
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# Load secrets from the env file (not checked into git)
EnvironmentFile=%h/.config/civilpdf/civilpdf.env

# スキーマ管理は Alembic に一本化 (Issue #109 修理済み: 新規DB・既存DBとも
# 冪等に upgrade head 可能)。起動時にマイグレーションを適用してから uvicorn を
# 起動する。補助経路として main.py の create_all も残るが、Alembic が正とする。
ExecStartPre=alembic upgrade head
ExecStart=uvicorn main:app --host 127.0.0.1 --port 8180

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
