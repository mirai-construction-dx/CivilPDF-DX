# CivilPDF-DX environment variables
# Copy to civilpdf.env and fill in real values.
# NEVER commit civilpdf.env to git.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://civildx:CHANGE_ME@localhost:5432/civildx

# ── Version ─────────────────────────────────────────────────
# /health と / に表示されるアプリバージョン（リポジトリ VERSION と一致させる）
# 整合確認: scripts/verify-version-sync.sh
APP_VERSION=0.9.0

# ── Monitoring / Alert ──────────────────────────────────────
# 障害・復旧・復元訓練失敗の通知先メール（未設定時は msmtp 既定アカウントへ）
# CIVILPDF_ALERT_TO=ops@example.com
# 同一障害の再通知間隔（分、既定 30）
# CIVILPDF_ALERT_MIN_INTERVAL=30

# ── Security ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_generate_with__openssl_rand_-hex_32
# 公開環境では必ず false (true は DEV AUTH BYPASS — 全リクエストが dev-admin になる)
DEBUG=false

# ── CORS ────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["https://civilpdf.mirai-dx-platform.com"]

# ── File uploads ────────────────────────────────────────────
UPLOAD_DIR=/var/lib/civildx/uploads

# ── AI (optional) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Microsoft 365 (optional) ────────────────────────────────
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=

# ── App Distribution ─────────────────────────────────────────
# Base URL of the GitHub Releases asset folder for the PDF Editor installers
# (this repository's Editor-specific tag editor-v<version>).
# When set, /api/v1/apps/download/* returns real download URLs (available=true).
# When empty, all packages show available=false ("準備中" on the UI).
# Format: https://github.com/<owner>/<repo>/releases/download/<tag>
APPS_RELEASE_BASE_URL=https://github.com/mirai-construction-dx/CivilPDF-DX/releases/download/editor-v1.12.6

# Optional per-package SHA-256 checksums (shown on the download page).
# Obtain from `sha256sum <installer-file>` after downloading the release assets.
# APPS_SHA256_WIN_EXE=
# APPS_SHA256_WIN_MSI=
# Distribution is Windows-only; macOS is pending (後日対応) and Linux is not distributed.

# Optional build metadata (injected by CI; safe to leave empty in dev).
# APPS_BUILD_COMMIT=
# APPS_BUILD_DATE=
# APPS_BUILD_NUMBER=
