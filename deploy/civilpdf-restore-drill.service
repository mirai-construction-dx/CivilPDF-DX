[Unit]
Description=CivilPDF-DX quarterly backup restore drill (non-destructive)
Documentation=https://github.com/mirai-construction-dx/CivilPDF-DX

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Mirai-Construction-DX/CivilPDF-DX
ExecStart=%h/Projects/Mirai-Construction-DX/CivilPDF-DX/scripts/restore-drill.sh
# 復元+起動+認証フローまで含むため、systemd 既定の 90 秒では不足し得る
TimeoutStartSec=10min

NoNewPrivileges=true

[Install]
WantedBy=default.target
