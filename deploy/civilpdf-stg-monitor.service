[Unit]
Description=CivilPDF-DX staging monitor (healthcheck + email alert)
Documentation=https://github.com/mirai-construction-dx/CivilPDF-DX/blob/main/docs/deployment/staging-environment.md

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Mirai-Construction-DX/CivilPDF-DX
ExecStart=%h/Projects/Mirai-Construction-DX/CivilPDF-DX/scripts/monitor-staging.sh
TimeoutStartSec=5min

NoNewPrivileges=true

[Install]
WantedBy=default.target
