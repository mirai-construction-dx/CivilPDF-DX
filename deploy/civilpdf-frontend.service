# =============================================================================
# ⛔ RETIRED（2026-09-18）: 本番フロントエンドは compose の frontend コンテナ
# （nginx + SPA + /api/ リバースプロキシ、:18970）が担当する。
# vite preview は開発用サーバーであり本番配信に用いない方針へ改めた。
# 新規インストールしないこと。退役手順: docs/operations/runbook.md §2.1
# =============================================================================

[Unit]
Description=CivilPDF-DX Console Frontend (vite preview 127.0.0.1:5182) [RETIRED — use docker compose]
Documentation=https://github.com/mirai-construction-dx/CivilPDF-DX
After=civilpdf-backend.service
Wants=civilpdf-backend.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Mirai-Construction-DX/CivilPDF-DX/src/console/frontend

# nvm-managed Node — expose the active version to systemd
Environment=PATH=%h/.nvm/versions/node/v25.2.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=VITE_API_URL=http://localhost:8180

# 127.0.0.1 bind — 外部公開は Cloudflare Tunnel (civilpdf-cloudflared.service) 経由のみ
ExecStart=%h/.nvm/versions/node/v25.2.1/bin/npm run preview -- --port 5182 --strictPort --host 127.0.0.1

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
