[Unit]
Description=CivilPDF-DX offsite backup sync (rclone)
Documentation=https://github.com/mirai-construction-dx/CivilPDF-DX

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Mirai-Construction-DX/CivilPDF-DX
EnvironmentFile=%h/.config/civilpdf/civilpdf.env
ExecStart=%h/Projects/Mirai-Construction-DX/CivilPDF-DX/scripts/backup-offsite.sh

NoNewPrivileges=true

[Install]
WantedBy=default.target
