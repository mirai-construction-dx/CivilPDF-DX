# =============================================================================
# CivilPDF-DX 環境設定テンプレート
# コピーして .env として使用: cp .env.example .env
#
# クロスプラットフォーム対応 (Linux / Windows 11 / macOS)
# Windows の場合: UPLOAD_DIR はバックスラッシュ不要 (Pythonが自動変換)
# =============================================================================

# ---------------- データベース ----------------
# 開発: SQLite (自動作成)
DATABASE_URL=sqlite:///./civilpdf_dev.db

# 本番: PostgreSQL (Docker Compose または外部 PostgreSQL)
# DATABASE_URL=postgresql://civilpdf:civildx_password@localhost:5432/civilpdf

# Windows 11 本番環境:
# DATABASE_URL=postgresql://civilpdf:civildx_password@localhost:5432/civilpdf

# Azure Database for PostgreSQL (クラウド):
# DATABASE_URL=postgresql://civilpdf@<server>.postgres.database.azure.com:5432/civilpdf?sslmode=require

# ---------------- ファイルストレージ ----------------
# Linux / macOS デフォルト: ~/civildx/uploads (config.py が自動設定)
# Windows デフォルト:       C:\Users\<user>\civildx\uploads (config.py が自動設定)
# 明示的に指定する場合のみ設定:
# UPLOAD_DIR=/var/civildx/uploads          # Linux 本番
# UPLOAD_DIR=C:/CivilPDF/uploads           # Windows 11 本番 (スラッシュ可)

MAX_FILE_SIZE_MB=100

# ---------------- 認証・セキュリティ ----------------
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------- CORS ----------------
# Tauri デスクトップクライアント (CivilPDF-Editor):
#   Linux/macOS: tauri://localhost / Windows: http://tauri.localhost
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5181","tauri://localhost","http://tauri.localhost"]

# ---------------- Microsoft 365 非対話式認証 ----------------
# Client Credentials Flow (非対話式) — Azure AD アプリ登録で取得
# Azure Portal > Azure Active Directory > アプリの登録
# 必要 API アクセス許可: Microsoft Graph > User.Read.All (アプリケーション)
M365_TENANT_ID=your-tenant-id
M365_CLIENT_ID=your-client-id
# client_secret は直接記載せず DB 暗号化経由で管理 (PATCH /api/v1/m365/settings)

# Fernet 暗号化キー (client_secret の DB 暗号化用)
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
M365_FERNET_KEY=

# M365 ログイン許可ネットワーク (空欄=全許可, 本番は LAN セグメントを指定)
# 例: M365_ALLOWED_NETWORKS=10.0.0.0/8,192.168.0.0/16
M365_ALLOWED_NETWORKS=

# ---------------- 外部ツール (Windows / Linux 両対応) ----------------
# veraPDF (PDF/A バリデーション) — Java 17+ 必要
# Linux:   VERAPDF_PATH=/usr/local/bin/verapdf
# Windows: VERAPDF_PATH=C:/verapdf/verapdf.bat
VERAPDF_PATH=

# Tesseract OCR (将来実装予定)
# Linux:   TESSERACT_PATH=/usr/bin/tesseract
# Windows: TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_PATH=

# ---------------- AI (Claude API) ----------------
ANTHROPIC_API_KEY=

# ---------------- OIDC SSO (Entra ID / HENNGE ONE) ----------------
# 詳細: docs/deployment/oidc-sso-setup.md
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email
OIDC_AUTO_PROVISION=true
# SPA のオリジン（OIDC コールバック後のリダイレクト先）
FRONTEND_ORIGIN=

# ---------------- アプリ設定 ----------------
APP_NAME=CivilPDF-DX
APP_VERSION=0.10.0
DEBUG=false
APP_PORT=8000
LOG_LEVEL=INFO
