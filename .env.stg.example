# =============================================================================
# CivilPDF-DX — STAGING environment for docker-compose.staging.yml
# -----------------------------------------------------------------------------
# 変数名だけを示す雛形。実値はリポジトリに置かない。
# 正本は ~/.config/civilpdf/stg.env (mode 0600):
#     install -m 600 .env.stg.example ~/.config/civilpdf/stg.env  # 値を記入
#     # compose 起動時に STG_ENV_FILE で正本を直接指す（リポジトリ内に置かない）
#     STG_ENV_FILE=~/.config/civilpdf/stg.env \
#       docker compose --env-file ~/.config/civilpdf/stg.env -f docker-compose.staging.yml up -d
#   （後方互換: ln -s ~/.config/civilpdf/stg.env .env.stg でもよい。.env.stg は gitignore 済み）
# 本番 (civilpdf.env) の値を流用しないこと。
#
# 識別子の正本: infra/staging/identifiers.json
# 決定: docs/architecture/ADR-0005-staging-environment.md (Conforms-to: MCDX-ADR-0010)
# =============================================================================

# ── 環境識別子（staging 固定。development / test を使わない）────────────────────
ENVIRONMENT=staging
DEBUG=false

# ── バージョン（リポジトリ VERSION と一致させる）────────────────────────────────
APP_VERSION=0.10.0

# ── PostgreSQL（compose が DATABASE_URL を自動組み立て）───────────────────────
POSTGRES_DB=civilpdf_stg
POSTGRES_USER=civilpdf_stg
# 必須。生成例: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── 公開ポート / プロセス数（loopback のみ）────────────────────────────────────
# stg が公開する唯一のポート。ホストでは 127.0.0.1:18971 に束縛される。
FRONTEND_PORT=18971
UVICORN_WORKERS=2

# ── セキュリティ（必須。本番とは別の値を生成する）─────────────────────────────
# JWT 署名鍵。必須。生成例: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# RFC 3161 ローカルタイムスタンプ署名のフォールバック HMAC 鍵。生成例: openssl rand -hex 32
TIMESTAMP_HMAC_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://civilpdf-stg.mirai-dx-platform.com"]

# ── ファイルアップロード ──────────────────────────────────────────────────────
# UPLOAD_DIR は compose 側で /app/uploads に固定（named volume にマウント）。
MAX_FILE_SIZE_MB=100

# ── AI（任意）────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Microsoft 365（任意 / client_secret の DB 暗号化鍵）───────────────────────
# 生成例: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
M365_FERNET_KEY=

# ── RFC 3161 外部 TSA（任意 / 未設定ならローカル HMAC にフォールバック）─────────
# TSA_URL=
# TSA_POLICY_OID=
# TSA_TIMEOUT_SECONDS=10

# ── アプリ配信（PDF Editor Client の配布窓口 /api/v1/apps）──────────────────────
# 例: https://github.com/mirai-construction-dx/CivilPDF-DX/releases/download/editor-v1.12.6
APPS_RELEASE_BASE_URL=

# ── サービス間連携（任意 / 未設定なら署名付き ping は 503。catalog は公開）──
# 全 worker 共用の専用 Redis が必要（未設定・接続不能時は fail closed）。
# INTEGRATION_NONCE_REDIS_URL=redis://integration-nonce-store:6379/0
# 呼び出し元 system_id -> 共有秘密の JSON。空文字を設定しないこと（起動時パース失敗）。
# 例: INTEGRATION_HMAC_SECRETS={"civil-docs-platform":"<openssl rand -hex 32>"}
# INTEGRATION_HMAC_SECRETS=
# 許容する時計ずれ（秒）。既定 300。
# INTEGRATION_CLOCK_SKEW_SECONDS=300
