{
  "name": "civildpf-dx-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:lan": "vite --config vite.lan.config.ts",
    "dev:lan:mock": "vite --config vite.lan.config.ts --mode mock",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --disable-wasm-trap-handler node_modules/.bin/vitest run --config vitest.config.ts",
    "test:watch": "node --disable-wasm-trap-handler node_modules/.bin/vitest --config vitest.config.ts",
    "test:coverage": "node --disable-wasm-trap-handler node_modules/.bin/vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.19.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^8.3.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  }
}
